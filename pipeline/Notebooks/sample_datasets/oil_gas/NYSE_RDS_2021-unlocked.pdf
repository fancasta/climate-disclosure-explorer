   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Miquel Gonzalez, Shell International Limited</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Shell Technology Centre Amsterdam. GeoCrawler uses deep learning image recognition technologies to identify geologic features in 3D seismic data--a potential step change in speed and effectiveness of subsurface interpretation. Proprietary deep learning tool to assist geoscientists with interpretation of seismic data. Geo Crawler is an application of machine learning on subsurface interpretation to improve production and recovery rates, particularly impacting more complex reservoirs. </rdf:li>
    </rdf:Alt>
   </dc:description>
