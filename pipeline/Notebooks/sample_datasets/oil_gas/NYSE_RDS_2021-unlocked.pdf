   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Hazira LNG (liquefied natural gas), India</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Shell hazira LNG port,India</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">STUART CONWAY</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Hazira is on the west coast of India in Gujarat State, about 25 km from Surat city and about 250 km from Mumbai. The port has great potential to serve as a 'Gateway Port' catering to diversified industry clusters in the hinterlands of North, West &amp; Central India.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>STUART CONWAY</rdf:li>
    </rdf:Seq>
   </dc:creator>
